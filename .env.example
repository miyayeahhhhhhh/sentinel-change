# Copy values into your shell environment (no .env loader is bundled). No secrets belong in source control.
# Values must not carry inline comments.
CS_MODE=sample
CS_DB_PATH=data/changesentinel.db
CS_OUTPUT_DIR=outputs
CS_REGISTRY_DIR=data/registry
CS_GEE_PROJECT=
CS_GEE_SERVICE_ACCOUNT=
CS_GEE_KEY_FILE=
CS_PC_SUBSCRIPTION_KEY=
CS_HTTP_TIMEOUT_S=30
# Google Earth Engine (authenticate separately with `earthengine authenticate`)
# Neo4j graph mirror (SQLite remains the system of record)
CS_NEO4J_URI=
CS_NEO4J_USER=
CS_NEO4J_PASSWORD=
# SMTP alert delivery (leave blank to disable)
CS_SMTP_HOST=
CS_SMTP_PORT=587
CS_SMTP_FROM=
CS_SMTP_USER=
CS_SMTP_PASSWORD=
CS_ALERT_TO=
# Sarvam AI native-language report generation (required for translated report)
SARVAM_API_KEY=
